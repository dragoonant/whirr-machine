[
  {
    "id": "cyg.a.evasive",
    "name": "Evasive",
    "text": "When an enemy ranged attack hits this model, it may advance 2 inches after the attack resolves.",
    "kind": "triggered",
    "trigger": "attack.resolved",
    "when": {
      "all": [
        {
          "test": "hit"
        },
        {
          "test": "attackKind",
          "value": "ranged"
        },
        {
          "test": "isEnemy",
          "subject": "attacker"
        }
      ]
    },
    "effect": [
      {
        "op": "advance",
        "dist": 2,
        "direction": "any"
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "instant",
    "optional": true
  },
