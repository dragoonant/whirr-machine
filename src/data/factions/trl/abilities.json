  {
    "id": "trl.a.dodge",
    "name": "Dodge",
    "text": "When an enemy attack misses this model, it may advance 2 inches after the attack resolves.",
    "kind": "triggered",
    "trigger": "attack.resolved",
    "when": {
      "all": [
        {
          "not": {
            "test": "hit"
          }
        },
        {
          "test": "isEnemy",
          "subject": "attacker"
        }
      ]
    },
    "effect": [
      {
        "op": "advance",
        "dist": 2,
        "direction": "any"
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "instant",
    "optional": true
  },
