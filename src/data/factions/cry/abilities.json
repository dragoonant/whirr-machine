  {
    "id": "cry.a.shadow-gate",
    "name": "Shadow Gate",
    "text": "Once per turn, after this model hits an enemy with a melee attack during its activation, it may spend one soul or corpse token to be placed completely within 2 inches of where it stands.",
    "kind": "triggered",
    "trigger": "attack.resolved",
    "when": {
      "all": [
        {
          "test": "hit"
        },
        {
          "test": "attackKind",
          "value": "melee"
        },
        {
          "test": "isEnemy",
          "subject": "target"
        },
        {
          "test": "tokensAtLeast",
          "subject": "self",
          "value": 1
        }
      ]
    },
    "effect": [
      {
        "code": "shadowGate"
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "instant",
    "optional": true,
    "limit": "oncePerTurn",
    "cost": {
      "soul": 1
    }
  },
