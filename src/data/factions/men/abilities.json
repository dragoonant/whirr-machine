[
  {
    "id": "men.a.stoke-the-pyre",
    "name": "Stoke the Pyre",
    "text": "Friendly Menoth models in this model's CTRL may burn the fire off an enemy to boost one melee attack or damage roll against it. This model may burn fire off an enemy in her CTRL to cast a spell for free.",
    "kind": "aura",
    "trigger": "passive",
    "effect": [
      {
        "op": "grantAbility",
        "ability": "men.a.stoke-boost-attack"
      },
      {
        "op": "grantAbility",
        "ability": "men.a.stoke-boost-damage"
      }
    ],
    "scope": {
      "who": "friendly",
      "range": "CTRL",
      "filter": {
        "test": "keyword",
        "value": "menoth"
      }
    },
    "duration": "continuous"
  },
  {
    "id": "men.a.stoke-boost-attack",
    "name": "Stoke the Pyre (attack)",
    "text": "Granted: against an enemy on fire, strip the fire to boost a melee attack roll (a roll is boosted once, so this is skipped when it already is). Used on the attack only when the hit is a long shot; otherwise the fire is kept for damage.",
    "kind": "triggered",
    "trigger": "attack.beforeRoll",
    "when": {
      "all": [
        {
          "test": "attackKind",
          "value": "melee"
        },
        {
          "test": "hasCondition",
          "subject": "target",
          "value": "fire"
        }
      ]
    },
    "effect": [
      {
        "code": "stokeStripAttack"
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "instant"
  },
  {
    "id": "men.a.stoke-boost-damage",
    "name": "Stoke the Pyre (damage)",
    "text": "Granted: against an enemy on fire, strip the fire to boost a melee damage roll (skipped when the roll is already boosted).",
    "kind": "triggered",
    "trigger": "damage.beforeRoll",
    "when": {
      "all": [
        {
          "test": "attackKind",
          "value": "melee"
        },
        {
          "test": "hasCondition",
          "subject": "target",
          "value": "fire"
        }
      ]
    },
    "effect": [
      {
        "code": "stokeStripDamage"
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "instant"
  },
