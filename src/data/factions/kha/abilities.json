[
  {
    "id": "kha.a.field-marshal-prowl",
    "name": "Field Marshal [Prowl]",
    "text": "Warjacks in this model's battlegroup have Prowl.",
    "kind": "aura",
    "trigger": "passive",
    "effect": [
      {
        "op": "grantAbility",
        "ability": "core.a.prowl"
      }
    ],
    "scope": {
      "who": "warEngines"
    },
    "duration": "continuous"
  },
  {
    "id": "kha.a.rise",
    "name": "Rise",
    "text": "At the start of maintenance a knocked-down model stands up.",
    "kind": "triggered",
    "trigger": "maintenance.start",
    "when": {
      "test": "hasCondition",
      "value": "knockedDown"
    },
    "effect": [
      {
        "op": "removeCondition",
        "condition": "knockedDown"
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "instant"
  },
  {
    "id": "kha.a.take-down",
    "name": "Take Down",
    "text": "A melee attack that boxes the target removes it from play and denies Tough.",
    "kind": "triggered",
    "trigger": "death.boxed",
    "when": {
      "test": "attackKind",
      "value": "melee"
    },
    "effect": [
      {
        "op": "forbid",
        "what": "tough"
      },
      {
        "op": "removeFromPlay"
      }
    ],
    "scope": {
      "who": "target"
    },
    "duration": "instant"
  },
