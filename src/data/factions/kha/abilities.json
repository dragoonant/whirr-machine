  {
    "id": "kha.a.anchor",
    "name": "Anchor",
    "text": "Friendly warrior models in base contact with this model cannot be knocked down.",
    "kind": "aura",
    "trigger": "passive",
    "effect": [
      {
        "op": "forbid",
        "what": "knockDown"
      }
    ],
    "scope": {
      "who": "friendly",
      "filter": {
        "test": "b2b"
      }
    },
    "duration": "continuous"
  },
  {
    "id": "kha.a.swift-hunter",
    "name": "Swift Hunter",
    "text": "After a basic ranged attack destroys an enemy, this model may advance 2 inches.",
    "kind": "triggered",
    "trigger": "attack.resolved",
    "when": {
      "code": "destroyedEnemyWithBasicRanged"
    },
    "effect": [
      {
        "op": "advance",
        "dist": 2,
        "direction": "any"
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "instant",
    "optional": true
  },
  {
    "id": "kha.a.marksman",
    "name": "Marksman",
    "text": "When this model damages a war-engine with a ranged attack, the attacker picks the grid column.",
    "kind": "triggered",
    "trigger": "damage.beforeApply",
    "effect": [
      {
        "code": "marksmanColumn"
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "instant"
  },
  {
    "id": "kha.a.girded",
    "name": "Girded",
    "text": "This model and friendly models in base contact with it have Resistance: Blast.",
    "kind": "aura",
    "trigger": "passive",
    "effect": [
      {
        "op": "grantResistance",
        "damageType": "blast"
      }
    ],
    "scope": {
      "who": "friendly",
      "filter": {
        "test": "b2b"
      }
    },
    "duration": "continuous"
  },
  {
    "id": "kha.a.shield-wall",
    "name": "Shield Wall",
    "text": "While in base contact with a unit-mate: +2 ARM and cannot be knocked down.",
    "kind": "passive",
    "trigger": "passive",
    "when": {
      "test": "b2b"
    },
    "effect": [
      {
        "op": "modStat",
        "stat": "ARM",
        "value": 2
      },
      {
        "op": "forbid",
        "what": "knockDown"
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "continuous"
  },
  {
    "id": "kha.a.ward-breaker",
    "name": "Ward Breaker",
    "text": "This attack gains the Blessed quality.",
    "kind": "specialAttack",
    "trigger": "attack.declared",
    "effect": [
      {
        "code": "grantQuality",
        "params": {
          "quality": "blessed"
        }
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "instant"
  },
  {
    "id": "kha.a.eruption-of-ash",
    "name": "Eruption of Ash",
    "text": "A direct hit that boxes the target leaves a fire hazard cloud for a round and removes the target from play.",
    "kind": "specialAttack",
    "trigger": "death.boxed",
    "effect": [
      {
        "op": "cloud",
        "area": "hazard",
        "placement": "centredOnTarget",
        "count": 1,
        "aoe": 3,
        "hazard": {
          "pow": 12,
          "damageType": "fire",
          "on": [
            "enter",
            "endActivation"
          ]
        }
      },
      {
        "op": "removeFromPlay"
      }
    ],
    "scope": {
      "who": "target"
    },
    "duration": "instant"
  },
  {
    "id": "kha.a.targeting-flare",
    "name": "Targeting Flare",
    "text": "Place a flare cloud within 10 inches; shots into it ignore intervening models.",
    "kind": "specialAttack",
    "trigger": "combat.choose",
    "effect": [
      {
        "op": "cloud",
        "area": "flare",
        "placement": "point",
        "aoe": 3,
        "blocksLos": false
      }
    ],
    "scope": {
      "who": "self"
    },
    "duration": "instant"
  },
  {
    "id": "kha.a.momentum",
