  {
    "id": "kha.a.anchor",
    "name": "Anchor",
    "text": "Friendly warrior models in base contact with this model cannot be knocked down.",
    "kind": "aura",
    "trigger": "passive",
    "effect": [
      {
        "op": "forbid",
        "what": "knockDown"
      }
    ],
    "scope": {
      "who": "friendly",
